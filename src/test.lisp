; Комплексный тест: строки, функции, сдвиги, ветвление и порты!
(progn
    ; 1. Сохраняем строку в память данных (Pascal string)
    (setq greeting "ITMO")

    ; 2. Функция возведения в квадрат
    (defun square (x)
        (* x x))

    ; 3. Считаем выражение: square(6) + (1 << 3) = 36 + 8 = 44
    (setq total (+ (square 6) (lsl 1 3)))

    ; 4. Ветвление: если total > 40, выводим букву 'Y' (ASCII 89), иначе 'N' (ASCII 78)
    (if (> total 40)
        (out 1 89)
        (out 1 78))
)
